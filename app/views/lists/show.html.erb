<div class="container my-5">
  <%= link_to "← Back to lists", root_path, class: "text-decoration-none" %>

  <div class="card shadow-sm mt-3 mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
      <h1 class="card-title h2 mb-0"><%= @list.name %></h1>
      <%= link_to "+ Add a movie", new_list_bookmark_path(@list), class: "btn btn-primary" %>
    </div>
  </div>

  <div class="row">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="col-md-4 col-lg-3 mb-4">
        <div class="card h-100">
          <img src="<%= bookmark.movie.poster_url %>" class="card-img-top" alt="<%= bookmark.movie.title %>">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= bookmark.movie.title %></h5>
            <p class="card-text small"><%= bookmark.movie.overview %></p>
            <p class="card-text fst-italic"><%= bookmark.comment %></p>
            <%= button_to "Delete", bookmark_path(bookmark), method: :delete, class: "btn btn-danger btn-sm mt-auto" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
